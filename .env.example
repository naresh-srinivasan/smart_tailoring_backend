# Copy to .env for local development. On Vercel, set these in Project > Settings > Environment Variables.
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=
DB_SSL=true
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
# Frontend origin(s) allowed by CORS and used in reset-password links. Comma separate several.
CLIENT_URL=http://localhost:3000
